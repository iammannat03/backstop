# LocalStack. Leave AWS_ENDPOINT_URL unset to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE_NAME=backstop-local

# Base URL of the ingestion API (the API Gateway stage URL when deployed).
# Used for POST /ingest/poll-now and POST /ingest/human-decision-notify.
INGESTION_URL=

# Used by the human approve/override path to call Stripe directly.
STRIPE_API_KEY=

# Optional, builds the Zendesk ticket links on the detail page.
ZENDESK_SUBDOMAIN=

# Sign in with Slack (Auth.js). Create a Slack app with "Sign in with Slack"
# (OpenID Connect) and add the redirect URL <site>/api/auth/callback/slack.
# Generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=
# Only members of this Slack workspace (team id, e.g. T0123ABCD) can sign in.
# Leave empty to allow any workspace, not recommended.
AUTH_SLACK_TEAM_ID=
# Comma separated Slack user ids (e.g. U012AB3CD). Admins can also use Refresh.
AUTH_ADMIN_IDS=
# Approvers can approve, override or hold. Everyone else in the workspace is a read-only viewer.
AUTH_APPROVER_IDS=
# Set to true to let signed-out visitors read the dashboard (never write).
AUTH_ALLOW_GUEST=
# Needed behind a proxy such as Amplify.
AUTH_TRUST_HOST=true
# Optional, the public site URL (e.g. https://main.example.amplifyapp.com).
AUTH_URL=
