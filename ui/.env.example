# LocalStack. Leave AWS_ENDPOINT_URL unset to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE_NAME=backstop-local

# Base URL of the ingestion API (the API Gateway stage URL when deployed).
# Used for POST /ingest/poll-now and POST /ingest/human-decision-notify.
INGESTION_URL=

# Used by the human approve/override path to call Stripe directly.
STRIPE_API_KEY=

# Optional, builds the Zendesk ticket links on the detail page.
ZENDESK_SUBDOMAIN=
