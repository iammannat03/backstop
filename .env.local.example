# Copy to .env.local for LocalStack runs. Dummy credentials, LocalStack
# does not check them, but the AWS SDK still requires something present.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
STAGE=local

# Same values these carried in backstop-prac, still needed for
# ingestion, execution, and audit. No GEMINI_API_KEY and no DATABASE_URL,
# Bedrock auth rides on the Lambda execution role and DynamoDB replaces
# the Postgres connection string.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SCOPE=tickets:read tickets:write users:read
ZENDESK_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/callback
STRIPE_API_KEY=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_CHANNEL_ID=
SLACK_COMMAND_ALLOWED_USER_IDS=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
